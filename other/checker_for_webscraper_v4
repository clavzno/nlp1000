from pathlib import Path
import hashlib

def hash_file(file_path):
    """Generate a hash for the file."""
    hasher = hashlib.md5()  # You can use sha256 or other algorithms
    with file_path.open("rb") as f:
        for chunk in iter(lambda: f.read(4096), b""):
            hasher.update(chunk)
    return hasher.hexdigest()

languages = ["spanish", "tagalog", "english", "hiligaynon", "bikol", "waray", "ilocano", "cebuano", "kapampangan", "pangasinense", "yakan", "ivatan", "tausug", "yami", "tuwali_ifugao", "masbateno"]

original_folder = Path("data/original")
comparison_folder = Path("data")

for lang in languages:
    original_file = original_folder / f"{lang}.txt"
    comparison_file = comparison_folder / f"{lang}.txt"

    # Check if both files exist
    if not original_file.exists():
        print(f"Original file missing: {original_file}")
        continue
    if not comparison_file.exists():
        print(f"Comparison file missing: {comparison_file}")
        continue

    # Compare hashes
    if hash_file(original_file) == hash_file(comparison_file):
        print(f"Files are the same: {lang}.txt")
    else:
        print(f"Files differ: {lang}.txt")